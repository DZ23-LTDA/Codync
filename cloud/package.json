{
  "name": "codync-cloud",
  "version": "2.2.0",
  "description": "Codync cloud: accounts, computers and the end-to-end encrypted relay (Cloudflare Worker + Durable Object)",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --env local",
    "deploy:dev": "wrangler deploy --env dev",
    "deploy:main": "wrangler deploy",
    "typecheck": "tsc && tsc -p test/e2e",
    "test": "vitest run",
    "e2e": "node --experimental-strip-types --no-warnings test/e2e/relay.e2e.ts"
  },
  "dependencies": {
    "@clerk/backend": "^3.20.1",
    "svix": "^2.5.0"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.23.0",
    "@cloudflare/workers-types": "^5.20260925.1",
    "@noble/ciphers": "^2.4.0",
    "@noble/curves": "^2.4.0",
    "@noble/hashes": "^2.4.0",
    "@types/node": "^26.6.2",
    "typescript": "^5.9.3",
    "vitest": "~4.1.11",
    "wrangler": "^4.156.0"
  },
  "overrides": {
    "sharp": "^0.35.5",
    "undici": "^7.30.1",
    "zod": "^4.6.6",
    "vite": "^8.3.3"
  }
}
